"1848%","2002%","2156%","2310%","2464%","2618%","2772%","2926%","3080%","3234%","3388%","3542%","3696%","3850%","4004%"]],["失衡倍率",["1004.9%","1050.6%","1096.3%","1142%","1187.7%","1233.4%","1279.1%","1324.8%","1370.5%","1416.2%","1461.9%","1507.6%","1553.3%","1599.0%","1644.7%","1690.4%"]],["失衡倍率（协同）",["1096.5%","1146.4%","1196.3%","1246.2%","1296.1%","1346%","1395.9%","1445.8%","1495.7%","1545.6%","1595.5%","1645.4%","1695.3%","1745.2%","1795.1%","1845%"]]],"max":12},{"kind":"核心被动","name":"爆破锤","desc":"珂蕾妲发动[强化特殊技]，或消耗[熔炉升温]发动强化[普通攻击]时，招式造成的失衡值提升30%。","rows":[["失衡值",["30%","35%","40%","45%","50%","55%","60%"]]],"max":7,"lvNames":["Lv.1","Lv.2 (A)","Lv.3 (B)","Lv.4 (C)","Lv.5 (D)","Lv.6 (E)","Lv.7 (F)"]},{"kind":"额外能力","name":"白祇管理学","desc":"队伍中存在与自身属性或阵营相同的角色时触发：\n珂蕾妲发动[强化特殊技]引发爆炸命中敌人时，对目标施加减益效果；当目标陷入失衡状态后，全队[连携技]对其造成的伤害提升35%，最多叠加2层，失衡状态结束时该效果重置。","rows":[]}],"cons":[{"name":"锤击节奏","desc":"当衔接在[普通攻击]第二、第四段或强化[普通攻击]后，\n快速发动[特殊技]或[强化特殊技]时，招式造成的失衡值提升15%。"},{"name":"动能回收","desc":"[强化特殊技]命中敌人时，珂蕾妲回复60点能量，45秒内最多触发一次。"},{"name":"「别惹我！」","desc":"[普通攻击]、[闪避]、[支援技]、[特殊技]、[连携技]技能等级+2"},{"name":"熔炉余温","desc":"消耗[熔炉升温]发动强化[普通攻击]时，珂蕾妲获得1层充能（上限2层）；\n[连携技]或[终结技]命中敌人时，消耗所有充能，每层充能使当前招式造成的伤害提升18%。"},{"name":"「敢小瞧我？」","desc":"[普通攻击]、[闪避]、[支援技]、[特殊技]、[连携技]技能等级+2"},{"name":"饱和爆破","desc":"在[强化特殊技]、[连携技]或[终结技]中，引发爆炸命中敌人时， 额外造成珂蕾妲360%攻击力的伤害。"}],"profile":{"affiliation":"白祇重工","species":"人类","height":"150cm","birthday":"8月10日","cv":{"zh":"穆雪婷","ja":"井口裕香","en":"Katie Cofield","ko":"정해은"}},"coreMats":["高维数据：钢铁恶意","活态驱动"],"chip":"火","rec":{"sets":[{"four":["山大王","原始朋克","摇摆爵士","静听嘉音"],"two":["震星迪斯科"],"why":"【角色定位】\n\n珂蕾妲是一名火属性的击破型代理人，她的速切失衡能力十分优秀，最常见的用法即是直接施放完强化特殊技就下场，失衡效率非常优秀，可以让敌人快速进入失衡期，适合搭配有爆发输出的角色。\n\n【4件套】\n\n由于珂蕾妲是一名速切击破角色，站场普攻无论是输出方面还是击破效率这方面的收益都是偏低的，震星迪斯科4件套对珂蕾妲收益并不高，推荐度非常低；更推荐选择现版本能够提供增伤的辅助套装。\n\n原始朋克只要队伍中能够触发招架支援（弹反/弹刀）或者闪避支援就可以触发10秒钟的增伤效果，覆盖率比较高，虽然2件套无用但4件套的效果是比较合适的辅助套装选择之一。该套装比较适合攻击欲望强的敌人；如果对抗的敌人是攻击欲望偏低的无法触发弹刀或闪支则该套装覆盖率偏低，不适合使用。\n\n摇摆爵士2件套提供回能，4件套同样能够提供增伤效果，持续12秒。通常用法是利用连携技触发能够覆盖失衡期间的增益，或者如果使用手动连携不让珂蕾妲打连携就用终结技作为打入失衡前的最后一击，以达成失衡期间的增益覆盖。\n\n队伍中有能触发快速支援的角色时，可以让珂蕾妲携带静听嘉音4件套为主C提供增伤，而另外一名角色可以按需选择其他辅助套装。\n\n【2件套】\n\n作为击破手，震星迪斯科2件套提供的冲击力依旧是非常适合她的词条，是最为推荐使用的2件套。"},{"four":["自由蓝调"],"two":["震星迪斯科"],"why":"【4件套】\n\n为提高队伍中火C的炎狱重金属的覆盖率，让珂蕾妲携带自由蓝调4件套可以提升火属性积蓄的积累速度。该套装仅适合在搭配需要灼烧的情况下使用。\n\n【2件套】\n\n同前。"},{"four":["震星迪斯科"],"two":["摇摆爵士"],"why":"【4件套】\n\n如前所述，震星迪斯科收益偏低，但如果实在需要珂蕾妲站场普攻而非速切，或者目前没有合适的套装使用，可以用震星迪斯科过渡。\n\n【2件套】\n\n大部分二件套的意义不是很大，珂蕾妲自身输出跟主C相比太少，叠输出的意义非常小，可以选择摇摆爵士2件套来回能。"}],"engines":[{"id":"14110","name":"燃狱齿轮"},{"id":"13005","name":"人为刀俎"},{"id":"13006","name":"贵重骨核"},{"id":"14003","name":"左轮转子"}],"main":["暴击率","火属性伤害加成","冲击力、能量自动回复"],"sub":"暴击率、暴击伤害、攻击力","skill":"「核心技」>「强化特殊技」>「连携技」=「闪避」>「普通攻击」>「支援技」","teams":[[{"id":"1041","name":"「11号」"},{"id":"1101","name":"珂蕾妲"},{"id":"1151","name":"露西"},{"name":"飚速布"}],[{"id":"1311","name":"耀嘉音"},{"id":"1321","name":"伊芙琳"},{"id":"1101","name":"珂蕾妲"},{"name":"飚速布"}],[{"id":"1611","name":"克拉蕾"},{"id":"1101","name":"珂蕾妲"},{"id":"1211","name":"丽娜"},{"name":"咔嚓仔"}]],"source":"bwiki"},"textLang":"zh","source":"hoyowiki+enka"}