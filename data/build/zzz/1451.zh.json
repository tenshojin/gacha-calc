害提升",["10%","11.7%","13.3%","15%","16.7%","18.3%","20%"]],["基础能量自动回复",["-","+0.12点/秒","-","+0.12点/秒","-","+0.12点/秒","-"]],["基础攻击力",["-","-","+25点","-","+25点","-","+25点"]]],"max":7,"lvNames":["Lv.1","Lv.2 (A)","Lv.3 (B)","Lv.4 (C)","Lv.5 (D)","Lv.6 (E)","Lv.7 (F)"]},{"kind":"额外能力","name":"长夜诗篇","desc":"队伍中存在[命破]角色或[击破]角色时触发：\n施加[破暗]状态时，额外附加暴击伤害提升30%效果。","rows":[]}],"cons":[{"name":"秘密朋友","desc":"[巡梦童谣]状态额外附加造成伤害时无视敌人18%全属性伤害抗性和喧响值获取效率提升5%效果；\n且卢西娅发动招式升级时获得1层[回音]，最多叠加4层，当[巡梦童谣]状态结束时，若卢西娅持有[回音]，则会自动消耗1层并重新为全队角色施加[巡梦童谣]状态。"},{"name":"魔术大师","desc":"卢西娅处于[以太帷幕·涌泉]内时[合唱]造成的伤害提升15%；\n拥有[破暗]状态的代理人，处于[以太帷幕·涌泉]内时，额外获得贯穿伤害提升15%效果。"},{"name":"最佳搭档","desc":"[普通攻击]、[闪避]、[支援技]、[特殊技]、[连携技]技能等级+2"},{"name":"深夜时间","desc":"当场上有[以太帷幕]开启或延长时，卢西娅使全队角色获得100点喧响值，该效果15秒内最多触发一次。"},{"name":"梦境守望人","desc":"[普通攻击]、[闪避]、[支援技]、[特殊技]、[连携技]技能等级+2"},{"name":"永不结束的旅途","desc":"卢西娅处于任意[以太帷幕]内时，会根据自身初始最大生命值的2%提升自身攻击力，且[合唱]必定暴击，[合唱]造成暴击时暴击伤害提升30%。"}],"profile":{"affiliation":"怪啖屋","species":"羊希人","height":"160cm","birthday":"3月17日","cv":{"zh":"梁爽","ja":"土屋李央","en":"Nola Klop","ko":"선정민"}},"coreMats":[],"chip":"以太","rec":{"sets":[{"four":["月光骑士颂"],"two":["云岿如我","摇摆爵士"],"why":"月光骑士颂二件套可以提升卢西娅的能量回复效率，四件套可以在发动强化特殊技或终结技后提升全队造成的伤害，二件套可以选择云岿如我提升卢西娅的生命值，如果音擎选择了铸梦炉歌，也可以选择摇摆爵士提升能量回复效率。"}],"engines":[{"id":"14145","name":"铸梦炉歌"},{"id":"13115","name":"好斗的阿炮"},{"id":"14002","name":"逍遥游球"}],"main":["生命值","生命值","生命值"],"sub":"生命值百分比、生命值、暴击率","skill":"核心技 F · 普通攻击 1+ · 闪避 1+ · 支援技 11+ · 特殊技 12 · 连携技 11+","teams":[[{"id":"1371","name":"仪玄"},{"id":"1481","name":"琉音"},{"id":"1451","name":"卢西娅"}],[{"id":"1371","name":"仪玄"},{"id":"1391","name":"橘福福"},{"id":"1451","name":"卢西娅"}],[{"id":"1471","name":"般岳"},{"id":"1481","name":"琉音"},{"id":"1451","name":"卢西娅"}],[{"id":"1471","name":"般岳"},{"id":"1391","name":"橘福福"},{"id":"1451","name":"卢西娅"}]],"source":"hoyowiki"},"textLang":"zh","source":"hoyowiki+enka"}